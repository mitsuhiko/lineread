# Editing details found by differential fuzzing (emacs mode): undo
# groups, aborts, overwrite mode, self-insert typeahead and counts.
tags: emacs
--- script
readline "> "

=== kill-whole-line-undo-group
tags: kill-whole-line undo
--- inputrc
"\C-xk": kill-whole-line
--- keys
abc<pause>\C-xk<pause>\C-xk<dumpfull>\C-_<dump>\r

=== yank-empty-kill-ring-aborts
tags: yank abort
keys: abc\C-y<dumpfull>x<dumpfull>\r

=== transpose-chars-end-negative-count
tags: transpose-chars numarg
keys: abcd\M--\C-t<dump>\M--2\C-t<dump>\r

=== downcase-word-unchanged-records-undo
tags: downcase-word undo
keys: abc def\C-a\M-l<dumpfull>\C-_<dump>\r

=== overwrite-typeahead-executing-key
tags: overwrite-mode typeahead
keys: abcdef\C-a<ins><pause>XYZ<dumpfull>\r

=== overwrite-zero-count-empty-group
tags: overwrite-mode numarg undo
keys: abc\C-a<ins><pause>\M-0<pause>x<dumpfull>\r

=== overwrite-rubout-at-end-group
tags: overwrite-mode backward-delete-char undo
keys: abc<ins><pause><bs><dumpfull>\C-_<dump>\r

=== self-insert-negative-count-takes-typeahead
tags: self-insert numarg typeahead
keys: ab\M--<pause> xyz<dumpfull>\r

=== self-insert-count-takes-typeahead
tags: self-insert numarg typeahead
keys: ab\M-2<pause>-xyz<dumpfull>\r

=== self-insert-negative-count-multibyte
tags: self-insert numarg utf8
keys: ab\M--<pause>日<dumpfull>\r

=== call-macro-while-defining-without-macro
tags: call-last-kbd-macro start-kbd-macro
keys: ab\C-x(\C-xe<dumpfull>c\C-x)<dumpfull>\r

=== end-empty-macro
tags: end-kbd-macro
keys: ab\C-x(\C-x)<dumpfull>\C-xe<dumpfull>\r

=== command-after-abort-clears-dispatching
tags: abort
keys: abc\C-g<dumpfull>\C-b<dumpfull>\r

=== print-empty-macro
tags: print-last-kbd-macro
--- inputrc
"\C-xp": print-last-kbd-macro
--- keys
ab\C-x(\C-x)\C-xp<snap>\r

=== numarg-not-kept-for-pushed-back-key
description: self-insert typeahead pushes the first non-insert key back; that key runs without the argument
tags: numarg typeahead self-insert
keys: ab\M-3,x<bs><dumpfull>\r

=== transpose-chars-single-multibyte-char
tags: transpose-chars utf8 undo
keys: é\C-t<dumpfull>\r

=== kill-region-prepends-when-point-after-mark
description: typeahead inserted by self-insert keeps the kill sequence going; kill-region kills from point to mark, so text before point is prepended
tags: kill-region kill typeahead
--- inputrc
"\C-xr": kill-region
--- keys
one two\C-a\M-d<pause>Z\C-xr<pause>\C-e\C-y<dump>\r

=== copy-region-prepends-when-point-after-mark
tags: copy-region-as-kill kill typeahead
--- inputrc
"\C-xc": copy-region-as-kill
--- keys
one two\C-a\M-d<pause>Z\C-xc<pause>\C-e\C-y<dump>\r

=== copy-region-appends-when-point-before-mark
tags: copy-region-as-kill kill typeahead
--- inputrc
"\C-xc": copy-region-as-kill
--- keys
one two\C-a\M-d<pause>Z\C-x\C-x\C-xc<pause>\C-e\C-y<dump>\r

=== copy-backward-word-prepends
tags: copy-backward-word kill typeahead
--- inputrc
"\C-xw": copy-backward-word
--- keys
one two\C-a\M-d<pause>Z\C-xw<pause>\C-e\C-y<dump>\r

=== copy-forward-word-appends
tags: copy-forward-word kill typeahead
--- inputrc
"\C-xf": copy-forward-word
--- keys
one two\C-a\M-d<pause>Z\C-xf<pause>\C-e\C-y<dump>\r

=== overwrite-negative-count-empty-group
tags: overwrite-mode numarg undo
keys: abc\C-a<ins><pause>\M--<pause>x<dumpfull>\r

=== kill-line-at-end-is-no-kill
description: kill-line with nothing to kill does not continue a kill sequence
tags: kill-line kill typeahead
keys: one\C-a\M-d<pause>\C-k<pause>ab\C-w<pause>\C-y<dump>\r

=== overwrite-rubout-tab-width-spaces
tags: overwrite-mode backward-delete-char
keys: ab\C-v\tc\C-b<ins><pause><bs><dumpfull>\r

=== overwrite-rubout-tab-after-text
tags: overwrite-mode backward-delete-char
keys: abcdefghij\C-v\tc\C-b<ins><pause><bs><dump>\r

=== character-search-count-beyond-matches
tags: character-search numarg
keys: abcabc\C-a\M-5\C-]c<dump>\M-5\M-\C-]a<dump>\r
