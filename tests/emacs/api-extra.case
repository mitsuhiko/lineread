--- script
option rlfree
history_arg_extract 5 6 "a b"
tilde_expand_word "plain"

=== mark-active-keep
tags: rl_keep_mark_active rl_activate_mark rl_mark_active_p
--- inputrc
set enable-active-region on
--- script
def b
rl_activate_mark
rl_keep_mark_active
rl_mark_active_p
end
defun t b
rl_bind_keyseq "\C-xt" t
readline "> "
--- keys
abc<pause>\C-@\C-a\C-xt<dump>\C-f<dump>\r

=== mark-active-keep-across-motion
tags: rl_keep_mark_active
--- inputrc
set enable-active-region on
--- script
def b
rl_keep_mark_active
end
defun keep b
rl_bind_keyseq "\C-xk" keep
def m
rl_mark_active_p
end
defun showm m
rl_bind_keyseq "\C-xm" showm
readline "> "
--- keys
hello\C-a<pause>\C-@\C-f\C-xk\C-xm\C-f\C-xm<snap>\r

