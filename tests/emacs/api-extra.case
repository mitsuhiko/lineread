=== maybe-save-unsave-roundtrip
tags: rl_maybe_save_line rl_maybe_unsave_line
--- script
add_history "hist"
def save
rl_maybe_save_line
rl_replace_line "temporary" 0
end
def restore
rl_maybe_unsave_line
dumpfull
end
defun sv save
defun rs restore
rl_bind_keyseq "\C-xs" sv
rl_bind_keyseq "\C-xr" rs
readline "> "
--- keys
mine\C-xs<dump>\C-xr\r

