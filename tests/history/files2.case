=== multiline-read
--- file ml.txt
#100
line a
line b
#200
single
--- script
set history_multiline_entries 1
read_history "ml.txt"
history_dump

=== multiline-without-flag
--- file ml.txt
#100
line a
line b
#200
single
--- script
read_history "ml.txt"
history_dump

=== multiline-blank-lines-kept
--- file ml.txt
#100
line a

line c
#200
single
--- script
set history_multiline_entries 1
read_history "ml.txt"
history_dump

=== multiline-enabled-by-write-timestamps
# with history_write_timestamps set, a timestamped file enables multi-line
# entries and increments history_multiline_entries
--- file ml.txt
#100
a
b
--- script
set history_write_timestamps 1
read_history "ml.txt"
history_dump
get history_multiline_entries
read_history "ml.txt"
get history_multiline_entries

=== multiline-long-continuation
--- script
def grow
file_append "ml.txt" "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
end
file_write "ml.txt" "#100\nstart\n"
repeat 12 grow
file_append "ml.txt" "\n"
repeat 12 grow
file_append "ml.txt" "\nend\n"
set history_multiline_entries 1
read_history "ml.txt"
get history_length
history_total_bytes

=== multiline-first-line-without-timestamp
--- file ml.txt
plain
#100
a
b
--- script
set history_multiline_entries 1
set history_comment_char "#"
read_history "ml.txt"
history_dump

=== multiline-roundtrip
--- script
set history_write_timestamps 1
set history_comment_char "#"
add_history "first\nsecond"
add_history_time "#100"
add_history "third"
add_history_time "#200"
write_history "rt.txt"
file_read "rt.txt"
clear_history
read_history "rt.txt"
history_dump

=== truncate-counter
--- script
history_truncate_file "five.txt" 2
get history_lines_written_to_file
file_read "five.txt"

=== truncate-more-than-file
--- script
history_truncate_file "five.txt" 10
get history_lines_written_to_file
file_read "five.txt"

=== truncate-exact
--- script
history_truncate_file "five.txt" 5
file_read "five.txt"
history_truncate_file "five.txt" 4
file_read "five.txt"

=== truncate-negative
--- script
history_truncate_file "five.txt" -1
file_read "five.txt"

=== truncate-zero-counter
--- script
history_truncate_file "five.txt" 0
get history_lines_written_to_file
file_stat "five.txt"

=== truncate-empty-file
--- file empty.txt noeol
--- script
history_truncate_file "empty.txt" 3
file_read "empty.txt"

=== truncate-missing
--- script
history_truncate_file "missing.txt" 3
get history_lines_written_to_file
file_stat "missing.txt"

=== truncate-directory
# not a regular file: nothing happens and the result is errno (0)
--- dir adir
--- script
history_truncate_file "adir" 1

=== truncate-unreadable
--- file secret.txt mode=0000
a
--- script
history_truncate_file "secret.txt" 1

=== truncate-no-trailing-newline
--- file noeol.txt noeol
a
b
c
--- script
history_truncate_file "noeol.txt" 1
file_read "noeol.txt"

