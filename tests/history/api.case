# History list API (history.c): adding, removing, replacing, stifling,
# navigation and state.  No terminal interaction.
tags: history api

=== add-and-list
--- script
add_history "first"
add_history "second"
add_history ""
history_dump
history_total_bytes

=== history-get-offsets
--- script
add_history "a"
add_history "b"
add_history "c"
history_get 0
history_get 1
history_get 3
history_get 4
history_get -1

=== remove-entries
--- script
add_history "a"
add_history "b"
add_history "c"
add_history "d"
remove_history 1
remove_history 10
remove_history -1
history_dump
remove_history_range 0 1
history_dump

=== replace-entry
--- script
add_history "a"
add_history "b"
replace_history_entry 1 "B" 42
replace_history_entry 5 "x" 0
history_dump

=== stifle
--- script
add_history "1"
add_history "2"
add_history "3"
add_history "4"
stifle_history 2
history_is_stifled
history_dump
add_history "5"
history_dump
unstifle_history
history_is_stifled
get history_max_entries
get max_input_history

=== stifle-negative-and-zero
--- script
add_history "1"
add_history "2"
stifle_history -5
history_is_stifled
history_dump
stifle_history 0
history_dump
add_history "3"
history_dump

=== navigation
--- script
add_history "a"
add_history "b"
add_history "c"
where_history
current_history
previous_history
previous_history
previous_history
previous_history
where_history
next_history
next_history
next_history
next_history
where_history
history_set_pos 1
current_history
history_set_pos 9
where_history

=== clear
--- script
add_history "a"
add_history "b"
clear_history
history_dump
get history_length
get history_base

=== history-base
--- script
set history_base 10
add_history "a"
add_history "b"
history_get 10
history_get 11
history_get 1
history_dump

=== search
--- script
add_history "make all"
add_history "git status"
add_history "make test"
add_history "ls"
history_set_pos 4
history_search "make" -1
where_history
history_search "make" -1
history_search "nomatch" -1
history_set_pos 0
history_search "make" 1
history_search_prefix "git" 1
history_search_prefix "status" 1
history_search_pos "make" -1 3
history_search_pos "make" 1 1

=== state-roundtrip
--- script
add_history "a"
add_history "b"
history_get_history_state
history_state_save 0
add_history "c"
history_state_save 1
history_state_restore 0
history_dump
history_state_restore 1
history_dump

=== entries-copy-and-alloc
--- script
add_history "abc"
copy_history_entry 1
copy_history_entry 0
alloc_history_entry "line" "#1234"
alloc_history_entry "line" NULL
history_get_time 1

=== add-history-time
--- script
add_history "a"
add_history_time "#1700000000"
add_history "b"
add_history_time "#1700000001"
history_dump
history_get_time 1
history_get_time 2
history_get_time 3

=== using-history
--- script
add_history "a"
previous_history
using_history
where_history
current_history

=== history-list-null-when-empty
--- script
history_list
history_get 0
current_history
