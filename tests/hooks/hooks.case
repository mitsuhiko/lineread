rl_alphabetic "a"

=== readline-name-conditional
tags: rl_readline_name
--- inputrc
$if myapp
"\C-xa": "in myapp"
$else
"\C-xa": "not myapp"
$endif
--- script
set rl_readline_name myapp
readline "> "
--- keys
\C-xa<dump>\r

