=== readline-state-during-command
tags: rl_readline_state
--- script
def s
get rl_readline_state
end
defun st s
rl_bind_keyseq "\C-xs" st
get rl_readline_state
readline "> "
get rl_readline_state
--- keys
\C-xs\r

=== save-restore-state
tags: rl_save_state rl_restore_state
--- script
def s
rl_save_state 0
set rl_point 0
set rl_mark 3
dump
rl_restore_state 0
dump
end
defun svst s
rl_bind_keyseq "\C-xs" svst
readline "> "
--- keys
original\C-a\C-f\C-xs<dump>\r

=== variable-value-runtime-change
tags: rl_variable_bind rl_variable_value
--- script
def v
rl_variable_bind mark-modified-lines on
rl_variable_bind bell-style none
rl_variable_bind completion-query-items 5
rl_variable_bind editing-mode vi
end
defun setv v
rl_bind_keyseq "\C-xv" setv
readline "> "
rl_variable_value mark-modified-lines
rl_variable_value bell-style
rl_variable_value completion-query-items
rl_variable_value editing-mode
--- keys
\C-xv<dump>\r

=== variable-value-unknown
tags: rl_variable_value rl_variable_bind
--- script
rl_variable_value no-such-variable
rl_variable_bind no-such-variable on
rl_variable_bind bell-style nonsense
rl_variable_value bell-style
rl_variable_bind mark-modified-lines 1
rl_variable_value mark-modified-lines
rl_variable_bind mark-modified-lines nope
rl_variable_value mark-modified-lines

