# Application hooks and globals: startup/pre-input/event hooks, terminal
# prep hooks, input stuffing, rl_read_key, rl_done, state save/restore.
tags: hooks api
--- script
readline "> "

=== startup-hook-called-once-per-line
tags: rl_startup_hook
--- script
set rl_startup_hook log
readline "> " 2
--- keys
a\rb\r

=== startup-hook-inserts-and-moves
tags: rl_startup_hook rl_insert_text
--- script
def s
rl_insert_text "hello world"
set rl_point 5
end
set rl_startup_hook script:s
readline "> "
--- keys
X<dump><snap>\r

=== startup-hook-sets-done
tags: rl_startup_hook rl_done
--- script
def s
rl_insert_text "auto"
set rl_done 1
end
set rl_startup_hook script:s
readline "> "
--- keys

=== startup-hook-state
tags: rl_startup_hook rl_readline_state
--- script
def s
get rl_readline_state
get rl_prompt
end
set rl_startup_hook script:s
readline "pp> "
--- keys
\r

=== pre-input-hook-order
tags: rl_pre_input_hook rl_startup_hook
--- script
def s
echo startup
end
def p
echo pre-input
get rl_readline_state
end
set rl_startup_hook script:s
set rl_pre_input_hook script:p
readline "> "
--- keys
\r

=== pre-input-hook-insert-and-redisplay
tags: rl_pre_input_hook
--- script
def p
rl_insert_text "pre"
rl_redisplay
end
set rl_pre_input_hook script:p
readline "> "
--- keys
<snap>X<dump>\r

=== input-available-hook
tags: rl_input_available_hook
--- inputrc
set keyseq-timeout 50
"\ez": "Z"
--- script
set rl_input_available_hook log
readline "> "
--- keys
a\e<pause>\r

=== input-available-hook-returns-true
tags: rl_input_available_hook
--- inputrc
set keyseq-timeout 50
--- script
def h
return 1
end
set rl_input_available_hook script:h
readline "> "
--- keys
ab\e<pause>b<dump>\r

=== prep-term-hooks
tags: rl_prep_term_function rl_deprep_term_function
--- script
set rl_prep_term_function log
set rl_deprep_term_function log
readline "> " 2
--- keys
a\rb\r

=== prep-term-hook-meta-flag
tags: rl_prep_term_function input-meta
--- inputrc
set input-meta off
--- script
set rl_prep_term_function log
readline "> "
--- keys
\r

=== prep-terminal-api
tags: rl_prep_terminal rl_deprep_terminal rltty
--- script
rl_initialize
rl_prep_terminal 1
get rl_readline_state
rl_deprep_terminal
get rl_readline_state
rl_deprep_terminal

=== prep-terminal-in-callback
tags: rl_prep_term_function callback
--- script
set rl_prep_term_function log
set rl_deprep_term_function log
callback "cb> "
--- keys
a\r

=== stuff-char-from-startup
tags: rl_stuff_char rl_pending_input
--- script
def s
rl_stuff_char "x"
rl_stuff_char "y"
get rl_pending_input
end
set rl_startup_hook script:s
readline "> "
--- keys
z<dump>\r

=== stuff-char-queue-full
tags: rl_stuff_char
--- script
def s
rl_stuff_char "1"
rl_stuff_char "2"
rl_stuff_char "3"
rl_stuff_char "4"
rl_stuff_char "5"
rl_stuff_char "6"
rl_stuff_char "7"
rl_stuff_char "8"
rl_stuff_char "9"
end
set rl_startup_hook script:s
readline "> "
--- keys
<dump>\r

=== stuff-char-runs-commands
tags: rl_stuff_char
--- script
def s
rl_stuff_char "\C-a"
end
defun stuff s
rl_bind_keyseq "\C-xs" stuff
readline "> "
--- keys
abc\C-xs<pause>X<dump>\r

=== execute-next
tags: rl_execute_next rl_pending_input
--- script
def e
rl_execute_next "\C-a"
get rl_pending_input
end
defun exnext e
rl_bind_keyseq "\C-xe" exnext
readline "> "
--- keys
abc\C-xeX<dump>\r

=== execute-next-overrides
tags: rl_execute_next
--- script
def e
rl_execute_next "a"
rl_execute_next "b"
end
defun exnext e
rl_bind_keyseq "\C-xe" exnext
readline "> "
--- keys
\C-xe<dump>\r

=== clear-pending-input
tags: rl_clear_pending_input rl_execute_next
--- script
def e
rl_execute_next "q"
rl_clear_pending_input
get rl_pending_input
end
defun exnext e
rl_bind_keyseq "\C-xe" exnext
readline "> "
--- keys
\C-xe<dump>\r

=== read-key-in-command
tags: rl_read_key
--- script
def r
rl_read_key
rl_read_key
end
defun readkeys r
rl_bind_keyseq "\C-xr" readkeys
readline "> "
--- keys
a\C-xrbcd<dump>\r

=== read-key-gets-stuffed-first
tags: rl_read_key rl_stuff_char
--- script
def r
rl_stuff_char "S"
rl_read_key
rl_read_key
end
defun readkeys r
rl_bind_keyseq "\C-xr" readkeys
readline "> "
--- keys
\C-xrK<dump>\r

