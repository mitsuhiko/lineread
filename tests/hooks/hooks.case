=== replace-line-api
tags: rl_replace_line
--- script
def r
rl_replace_line "brand new" 1
end
defun repl r
rl_bind_keyseq "\C-xr" repl
readline "> "
--- keys
old text\C-xr<dumpfull><snap>\r

=== replace-line-empty
tags: rl_replace_line
--- script
def r
rl_replace_line "" 0
end
defun repl r
rl_bind_keyseq "\C-xr" repl
readline "> "
--- keys
old\C-xr<dump>\r

=== copy-text-api
tags: rl_copy_text
--- script
def c
rl_copy_text 0 3
rl_copy_text 2 1
rl_copy_text 0 100
end
defun cp c
rl_bind_keyseq "\C-xc" cp
readline "> "
--- keys
abcdef\C-xc\r

=== delete-text-api-variants
tags: rl_delete_text
--- script
def d
rl_delete_text 4 2
set rl_point 0
rl_delete_text 0 0
rl_delete_text 10 20
end
defun del d
rl_bind_keyseq "\C-xd" del
readline "> "
--- keys
abcdefgh\C-xd<dump>\r

=== insert-text-empty-and-long
tags: rl_insert_text rl_extend_line_buffer
--- script
def i
rl_insert_text ""
rl_extend_line_buffer 5000
rl_insert_text "0123456789012345678901234567890123456789"
end
defun ins i
rl_bind_keyseq "\C-xi" ins
readline "> "
--- keys
\C-xi<dump>\r

=== insert-text-outside-readline
tags: rl_insert_text
--- script
rl_initialize
rl_insert_text "abc"
dump
rl_delete_text 0 1
dump
rl_kill_text 0 1
dump

=== executing-keymap-and-key
tags: rl_executing_keymap rl_executing_key rl_executing_keyseq
--- script
def k
get rl_executing_keymap
get rl_executing_key
get rl_executing_keyseq
get rl_key_sequence_length
get rl_dispatching
get rl_binding_keymap
end
defun keyinfo k
rl_bind_keyseq "\C-xk" keyinfo
rl_bind_keyseq "\M-k" keyinfo
rl_bind_keyseq "\C-k" keyinfo
readline "> "
get rl_dispatching
--- keys
\C-xk\M-k\C-k\r

=== executing-keyseq-vi
tags: rl_executing_keymap vi
--- inputrc
set editing-mode vi
set keyseq-timeout 50
--- script
def k
get rl_executing_keymap
get rl_executing_keyseq
end
defun keyinfo k
rl_bind_keyseq_in_map "\C-x" keyinfo vi-insert
rl_bind_keyseq_in_map "\C-x" keyinfo vi-command
readline "> "
--- keys
\C-x\e<pause>\C-x\r

=== last-func-tracking
tags: rl_last_func
--- script
def l
get rl_last_func
end
defun lastf l
rl_bind_keyseq "\C-xl" lastf
readline "> "
get rl_last_func
--- keys
a\C-xl\C-b\C-xl\M-f\C-xl\r

