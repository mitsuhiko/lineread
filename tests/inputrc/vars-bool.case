# Readline variables: every boolean variable accepts on/off via `set` and
# rl_variable_bind; rl_variable_value reports it.  Defaults are checked
# after rl_initialize (some depend on the locale).
tags: inputrc vars bool

=== bind-tty-special-chars
--- script
rl_initialize
rl_variable_value "bind-tty-special-chars"
rl_parse_and_bind "set bind-tty-special-chars on"
rl_variable_value "bind-tty-special-chars"
rl_parse_and_bind "set bind-tty-special-chars off"
rl_variable_value "bind-tty-special-chars"
rl_variable_bind "bind-tty-special-chars" "1"
rl_variable_value "bind-tty-special-chars"
rl_variable_bind "bind-tty-special-chars" "0"
rl_variable_value "bind-tty-special-chars"

