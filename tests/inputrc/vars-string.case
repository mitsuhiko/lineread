rl_parse_and_bind "set keyseq-timeout fast"
rl_variable_value "keyseq-timeout"

=== active-region-colors
--- script
rl_variable_value "active-region-start-color"
rl_variable_value "active-region-end-color"
rl_parse_and_bind "set active-region-start-color \"\\e[01;33m\""
rl_parse_and_bind "set active-region-end-color \"\\e[0m\""
rl_variable_value "active-region-start-color"
rl_variable_value "active-region-end-color"
rl_parse_and_bind "set active-region-start-color"
rl_variable_value "active-region-start-color"

=== active-region-colors-after-initialize
--- script
rl_initialize
rl_variable_value "active-region-start-color"
rl_variable_value "active-region-end-color"

=== active-region-colors-control-chars
--- script
rl_parse_and_bind "set active-region-start-color \\C-a\\M-b\\t"
rl_variable_value "active-region-start-color"

=== string-variable-names-case-insensitive
--- script
rl_parse_and_bind "set Keyseq-Timeout 77"
rl_variable_value "KEYSEQ-TIMEOUT"
rl_parse_and_bind "set COMMENT-BEGIN %"
rl_variable_value "comment-begin"
