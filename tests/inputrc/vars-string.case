rl_variable_value "vi-cmd-mode-string"

=== mode-string-shown-in-prompt-emacs
tags: readline
--- inputrc
set show-mode-in-prompt on
set emacs-mode-string "[E]"
--- script
readline "> "
--- keys
abc\r

=== mode-string-shown-in-prompt-vi
tags: readline
--- inputrc
set editing-mode vi
set keyseq-timeout 50
set show-mode-in-prompt on
set vi-ins-mode-string "<I>"
set vi-cmd-mode-string "<C>"
--- script
readline "> "
--- keys
abc<snap>\e<pause><snap>\r

=== mode-string-invisible-markers
tags: readline
--- inputrc
set show-mode-in-prompt on
set emacs-mode-string "\1\e[1m\2E\1\e[0m\2 "
--- script
readline "> "
--- keys
abc<dump>\r

=== mode-string-default-shown
tags: readline
--- inputrc
set show-mode-in-prompt on
--- script
readline "> "
--- keys
x\r

=== show-mode-in-prompt-toggle-at-runtime
tags: readline
--- script
def toggle
rl_variable_bind "show-mode-in-prompt" "on"
end
defun toggle-mode toggle "\C-t"
readline "> "
--- keys
ab<snap>\C-t\C-l<snap>\r

=== history-size-values
--- script
rl_parse_and_bind "set history-size 10"
rl_variable_value "history-size"
history_is_stifled
get history_max_entries
rl_parse_and_bind "set history-size -1"
rl_variable_value "history-size"
history_is_stifled
rl_parse_and_bind "set history-size"
rl_variable_value "history-size"
rl_parse_and_bind "set history-size 0"
rl_variable_value "history-size"
rl_parse_and_bind "set history-size abc"
rl_variable_value "history-size"

=== history-size-truncates-history
--- script
add_history "a"
add_history "b"
add_history "c"
rl_parse_and_bind "set history-size 2"
history_dump

=== isearch-terminators-values
--- script
rl_variable_value "isearch-terminators"
rl_parse_and_bind "set isearch-terminators \"\\C-a\\C-b\""
rl_variable_value "isearch-terminators"
rl_parse_and_bind "set isearch-terminators 'xy'"
rl_variable_value "isearch-terminators"
rl_parse_and_bind "set isearch-terminators abc def"
rl_variable_value "isearch-terminators"
rl_parse_and_bind "set isearch-terminators \\e"
rl_variable_value "isearch-terminators"

=== isearch-terminators-variable-bind-null
--- script
rl_variable_bind "isearch-terminators" NULL
rl_variable_value "isearch-terminators"

=== isearch-terminators-effect
tags: readline
--- inputrc
set isearch-terminators "x"
--- script
add_history "hello world"
readline "> "
--- keys
\C-rworxZ<dump>\r

