rl_variable_value "keymap"
rl_parse_and_bind "set keymap vi"
rl_variable_value "keymap"
rl_parse_and_bind "set keymap emacs-meta"
rl_variable_value "keymap"
rl_parse_and_bind "set keymap emacs-ctlx"
rl_variable_value "keymap"
