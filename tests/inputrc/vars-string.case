=== completion-query-items-application-variable
--- script
set rl_completion_query_items 33
rl_variable_value "completion-query-items"

=== editing-mode-values
--- script
rl_parse_and_bind "set editing-mode vi"
rl_variable_value "editing-mode"
get rl_editing_mode
rl_get_keymap
rl_parse_and_bind "set editing-mode emacs"
rl_variable_value "editing-mode"
get rl_editing_mode
rl_get_keymap

=== editing-mode-prefix-match
# only the first two (vi) or five (emacs) characters are compared
--- script
rl_parse_and_bind "set editing-mode VIM"
rl_variable_value "editing-mode"
rl_parse_and_bind "set editing-mode emacsen"
rl_variable_value "editing-mode"
rl_parse_and_bind "set editing-mode Emacs"
rl_variable_value "editing-mode"

=== editing-mode-invalid
--- script
rl_parse_and_bind "set editing-mode vi"
rl_parse_and_bind "set editing-mode ed"
rl_variable_value "editing-mode"
rl_parse_and_bind "set editing-mode"
rl_variable_value "editing-mode"

=== editing-mode-inputrc-affects-readline
tags: readline
--- inputrc
set editing-mode vi
set keyseq-timeout 50
--- script
readline "> "
--- keys
abc\e<pause>0<dump>\r

=== emacs-mode-string-values
--- script
rl_variable_value "emacs-mode-string"
rl_parse_and_bind "set emacs-mode-string E:"
rl_variable_value "emacs-mode-string"
rl_parse_and_bind "set emacs-mode-string \"\\e[1m@\\e[0m\""
rl_variable_value "emacs-mode-string"
rl_parse_and_bind "set emacs-mode-string"
rl_variable_value "emacs-mode-string"
rl_variable_bind "emacs-mode-string" NULL
rl_variable_value "emacs-mode-string"

