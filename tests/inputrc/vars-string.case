# String and numeric readline variables: valid, invalid and edge values
# through `set` (rl_parse_and_bind) and rl_variable_value.
tags: inputrc vars string
screen: 160x24

=== bell-style-values
--- script
rl_parse_and_bind "set bell-style none"
rl_variable_value "bell-style"
rl_parse_and_bind "set bell-style audible"
rl_variable_value "bell-style"
rl_parse_and_bind "set bell-style visible"
rl_variable_value "bell-style"
rl_parse_and_bind "set bell-style off"
rl_variable_value "bell-style"
rl_parse_and_bind "set bell-style on"
rl_variable_value "bell-style"

=== bell-style-case-insensitive
--- script
rl_parse_and_bind "set bell-style NONE"
rl_variable_value "bell-style"
rl_parse_and_bind "set bell-style Visible"
rl_variable_value "bell-style"

=== bell-style-empty-and-invalid
--- script
rl_parse_and_bind "set bell-style none"
rl_parse_and_bind "set bell-style"
rl_variable_value "bell-style"
rl_parse_and_bind "set bell-style none"
rl_parse_and_bind "set bell-style loud"
rl_variable_value "bell-style"

=== bell-style-sets-prefer-visible-bell
--- script
rl_parse_and_bind "set bell-style visible"
rl_variable_value "prefer-visible-bell"

=== comment-begin-values
--- script
rl_variable_value "comment-begin"
rl_parse_and_bind "set comment-begin //"
rl_variable_value "comment-begin"
rl_parse_and_bind "set comment-begin"
rl_variable_value "comment-begin"
rl_variable_bind "comment-begin" NULL
rl_variable_value "comment-begin"

=== comment-begin-used-by-insert-comment
tags: readline
--- inputrc
set comment-begin "// "
--- script
readline "> "
--- keys
abc\M-#

