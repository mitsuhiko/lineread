=== keymap-invalid
--- script
rl_parse_and_bind "set keymap vi-insert"
rl_parse_and_bind "set keymap nosuchmap"
rl_variable_value "keymap"
rl_parse_and_bind "set keymap"
rl_variable_value "keymap"

=== keymap-anonymous-falls-back-to-edit-mode
--- script
keymap_new anon bare
rl_set_keymap anon
rl_variable_value "keymap"

=== keymap-set-name-reported
--- script
keymap_new mine bare
rl_set_keymap_name "my-map" mine
rl_parse_and_bind "set keymap my-map"
rl_variable_value "keymap"
rl_parse_and_bind "\"a\": forward-char"
rl_function_of_keyseq "a" mine

=== keymap-reset-by-inputrc-end
# readline restores the edit mode keymap after reading the init file
--- inputrc
set keymap vi-command
--- script
rl_initialize
rl_variable_value "keymap"
rl_get_keymap

