--- script
rl_variable_value "vi-ins-mode-string"
rl_variable_value "vi-cmd-mode-string"
rl_parse_and_bind "set vi-ins-mode-string +"
rl_parse_and_bind "set vi-cmd-mode-string :"
rl_variable_value "vi-ins-mode-string"
rl_variable_value "vi-cmd-mode-string"
rl_parse_and_bind "set vi-ins-mode-string \\C-a"
rl_variable_value "vi-ins-mode-string"
rl_parse_and_bind "set vi-ins-mode-string"
rl_parse_and_bind "set vi-cmd-mode-string"
rl_variable_value "vi-ins-mode-string"
rl_variable_value "vi-cmd-mode-string"
rl_variable_bind "vi-ins-mode-string" NULL
rl_variable_bind "vi-cmd-mode-string" NULL
