=== completion-entry-function-username
--- script
set rl_completion_entry_function username
readline "> "
--- keys
~nosuchuser_lineread\t<dump>\r

=== username-generator
# the password database differs: macOS lists root twice (see the
# .expected.linux.json for Linux)
--- script
gen username "~nosuchuser_lineread"
gen username "nosuchuser_lineread"
gen username "~roo"
gen username "roo"

=== username-generator-sets-filename-desired
--- script
set rl_filename_completion_desired 0
gen username "~roo"
get rl_filename_completion_desired
set rl_filename_completion_desired 0
gen username "roo"
get rl_filename_completion_desired

