=== complete-internal-what-to-do
--- script
def doit
rl_complete_internal "!"
end
def doit2
rl_complete_internal "@"
end
def doit3
rl_complete_internal "|"
end
complete_words apple apricot
set rl_attempted_completion_function words
defun do-bang doit "\C-t"
defun do-at doit2 "\C-y"
defun do-bar doit3 "\C-o"
readline "> "
--- keys
a\C-t<snap><dump>\C-u\C-yap\C-y<snap>\C-o<snap>\r

=== complete-internal-bang-unique
--- script
def doit
rl_complete_internal "!"
end
complete_words apple apricot
set rl_attempted_completion_function words
defun do-bang doit "\C-t"
readline "> "
--- keys
app\C-t<dump>\r

