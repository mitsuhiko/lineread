=== found-quote-flags
--- script
def show
get rl_completion_found_quote
get rl_completion_quote_character
args
return NULL
end
set rl_completer_quote_characters "\"'`"
set rl_attempted_completion_function script:show
readline "> "
--- keys
"ab\t\C-a\C-k'cd\t\C-a\C-k`ef\t\C-a\C-ka\\ b\t\C-a\C-k"x" y\t\r

