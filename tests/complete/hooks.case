=== export-completions-api
--- script
complete_words apple apricot
set rl_attempted_completion_function words
rl_initialize
rl_insert_text "ap"
capture rl_export_completions 1 0

=== completion-matches-api
--- script
complete_words abc abd abd xyz
rl_completion_matches "ab" words
rl_completion_matches "" words
rl_completion_matches "xyz" words
rl_completion_matches "q" empty

=== completion-matches-many
--- script
complete_words m01 m02 m03 m04 m05 m06 m07 m08 m09 m10 m11 m12 m13 m14 m15 m16 m17 m18 m19 m20 m21 m22 m23 m24 m25
rl_completion_matches "m" words
rl_completion_matches "m1" words

=== completion-matches-case-fold-lcd
--- inputrc
set completion-ignore-case on
--- script
rl_initialize
complete_words -i Apple APPLY apPlication
rl_completion_matches "app" words
rl_completion_matches "APP" words
rl_completion_matches "xpp" words

=== completion-matches-case-fold-multibyte
--- inputrc
set completion-ignore-case on
--- script
rl_initialize
complete_words -i "Äpfel" "äpfelchen"
rl_completion_matches "äp" words

=== completion-matches-invalid-utf8
--- script
rl_initialize
complete_words "a\xffb" "a\xffc"
rl_completion_matches "a" words

=== completion-matches-no-common-prefix
--- script
complete_words xa ya
rl_completion_matches "" words
complete_words -i Xa xb
rl_completion_matches "x" words

=== complete-in-callback-mode
tags: callback
--- script
complete_words apple apricot avocado
set rl_attempted_completion_function words
callback "> "
