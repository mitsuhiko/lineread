# Completion hooks and application variables (readline.h): attempted
# completion function, entry function, ignore function, display hook,
# word break hook/characters, quote characters, special prefixes, append
# character, suppress append/quote, completion type, invoking key,
# found quote, quote character, mark symlink dirs, rl_completion_mode,
# rl_complete_internal, export-completions, username completion.
tags: complete hooks

=== attempted-function-args-and-type
--- script
def show
args
get rl_completion_type
get rl_completion_invoking_key
get rl_completion_found_quote
get rl_completion_quote_character
get rl_filename_completion_desired
get rl_filename_quoting_desired
get rl_completion_append_character
get rl_completion_suppress_append
get rl_completion_mark_symlink_dirs
return NULL
end
set rl_attempted_completion_function script:show
readline "> "
--- keys
abc de\t\r

=== completion-type-per-command
--- script
def show
get rl_completion_type
return NULL
end
set rl_attempted_completion_function script:show
readline "> "
--- keys
zz\t\t\M-?\M-*\r

