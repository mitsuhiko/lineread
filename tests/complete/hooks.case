=== display-matches-hook-custom-output
--- script
def show
rl_crlf
echo shown
capture display_match_list
rl_on_new_line
end
complete_words red green blue brown
set rl_attempted_completion_function words
set rl_completion_display_matches_hook script:show
readline "> "
--- keys
b\M-?<snap>\r

=== display-match-list-api
--- script
rl_initialize
capture display_match_list "b" "blue" "brown" "black"
capture display_match_list "" "a" "bb" "ccc"
capture display_match_list "x" "x"

=== display-match-list-api-filenames
--- file dir/one
--- dir dir/two
--- script
rl_initialize
set rl_filename_completion_desired 1
capture display_match_list "dir/" "dir/one" "dir/two"

=== display-match-list-api-visible-stats
--- file dir/one
--- dir dir/two
--- symlink dir/three one
--- file dir/four mode=0755
--- inputrc
set visible-stats on
--- script
rl_initialize
set rl_filename_completion_desired 1
capture display_match_list "dir/" "dir/one" "dir/two" "dir/three" "dir/four"
capture display_match_list "" "/" "dir/" "dir/two/"

=== display-match-list-root-paths
--- inputrc
set visible-stats on
--- script
rl_initialize
set rl_filename_completion_desired 1
capture display_match_list "/" "/dev" "/usr"
capture display_match_list "//" "//dev"

