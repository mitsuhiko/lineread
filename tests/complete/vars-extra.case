=== full-quoting-desired-quotes-whole
tags: rl_full_quoting_desired
--- script
file_write "my file.txt" "x"
set rl_completer_quote_characters "'\""
def fq
set rl_full_quoting_desired 1
return filename
end
set rl_attempted_completion_function script:fq
readline "> "
--- keys
cat my\t<dump>\r

=== full-quoting-desired-off-backslashes
tags: rl_full_quoting_desired
--- script
file_write "my file.txt" "x"
set rl_completer_quote_characters "'\""
def fq
set rl_full_quoting_desired 0
return filename
end
set rl_attempted_completion_function script:fq
readline "> "
--- keys
cat my\t<dump>\r

=== full-quoting-desired-no-special-chars
tags: rl_full_quoting_desired
--- script
file_write "my file.txt" "x"
set rl_completer_quote_characters "'\""
def fq
set rl_full_quoting_desired 1
return filename
end
set rl_attempted_completion_function script:fq
readline "> "
--- keys
