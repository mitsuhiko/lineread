=== inhibit-completion-tab-self-inserts
tags: rl_inhibit_completion
--- script
set rl_inhibit_completion 1
readline "> "
--- keys
al\t<dump>\r

=== inhibit-completion-toggled-in-command
tags: rl_inhibit_completion
--- script
def off
set rl_inhibit_completion 0
end
defun allow off
rl_bind_keyseq "\C-xa" allow
set rl_inhibit_completion 1
readline "> "
--- keys
al\t\C-?\C-xa\t<dump>\r

=== inhibit-completion-menu-and-list
tags: rl_inhibit_completion
--- inputrc
"\C-n": menu-complete
--- script
set rl_inhibit_completion 1
readline "> "
--- keys
al\C-n<dump>\M-?<dump>\r

=== special-prefixes-dollar-word
tags: rl_special_prefixes
--- script
set rl_special_prefixes "$"
complete_words $HOME $HOSTNAME
set rl_completion_entry_function words
readline "> "
--- keys
echo $HOM\t<dump>\r

=== special-prefixes-two-chars
tags: rl_special_prefixes
--- script
set rl_special_prefixes "@%"
def show
args
return NULL
end
set rl_attempted_completion_function script:show
readline "> "
--- keys
x @us\t y %jo\t\r

=== completion-rewrite-hook-display
tags: rl_completion_rewrite_hook
--- script
def up
args
end
set rl_completion_rewrite_hook script:up
readline "> "
--- keys
cat al\t\t<snap>\r

=== completion-rewrite-hook-in-readline
tags: rl_completion_rewrite_hook
--- script
def up
return "alpha.txt"
end
set rl_completion_rewrite_hook script:up
readline "> "
--- keys
cat zz\t<dump>\r

=== directory-rewrite-hook-log
tags: rl_directory_rewrite_hook
--- script
set rl_directory_rewrite_hook log
readline "> "
--- keys
cat subdir/in\t<dump>\r

=== directory-rewrite-hook-gen
tags: rl_directory_rewrite_hook
--- script
def rw
args
replace_arg "subdir"
return 1
end
set rl_directory_rewrite_hook script:rw
gen filename "nowhere/in" sort
gen filename "subdir/" sort

=== filename-rewrite-hook-readline
tags: rl_filename_rewrite_hook
--- script
def rw
return "UPPER"
end
set rl_filename_rewrite_hook script:rw
readline "> "
--- keys
cat UP\t<dump>\r

=== filename-rewrite-hook-matches-rewritten
tags: rl_filename_rewrite_hook
--- script
def rw
return "ALPHA"
end
set rl_filename_rewrite_hook script:rw
gen filename "AL" sort
gen filename "al" sort

=== menu-completion-entry-function-words
tags: rl_menu_completion_entry_function menu-complete
--- inputrc
"\C-n": menu-complete
--- script
complete_words red green grey
set rl_menu_completion_entry_function words
readline "> "
--- keys
g\C-n<dump>\C-n<dump>\t<dump>\r

=== menu-completion-entry-function-vs-entry
tags: rl_menu_completion_entry_function rl_completion_entry_function menu-complete
--- inputrc
"\C-n": menu-complete
--- script
complete_words gamma golf
set rl_completion_entry_function words
set rl_menu_completion_entry_function filename
readline "> "
--- keys
al\C-n<dump>\C-u g\t<dump>\r

=== menu-completion-entry-function-empty
tags: rl_menu_completion_entry_function menu-complete
--- inputrc
"\C-n": menu-complete
--- script
set rl_menu_completion_entry_function empty
readline "> "
--- keys
al\C-n<dump>\r
