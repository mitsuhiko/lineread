# Completion variables and hooks with few behavioural cases elsewhere.
tags: complete vars
--- file alpha.txt
x
--- file alpine.txt
x
--- dir subdir
--- file subdir/inner.c
x

=== basic-word-break-characters-used-by-default
tags: rl_basic_word_break_characters
--- script
set rl_basic_word_break_characters " ="
set rl_completer_word_break_characters NULL
def show
args
return NULL
end
set rl_attempted_completion_function script:show
readline "> "
--- keys
cmd --opt=val:al\t\r

=== basic-word-break-characters-default-value
tags: rl_basic_word_break_characters rl_completer_word_break_characters
--- script
get rl_basic_word_break_characters
get rl_completer_word_break_characters
rl_initialize
get rl_completer_word_break_characters

=== basic-word-break-characters-semicolon
tags: rl_basic_word_break_characters
--- script
set rl_basic_word_break_characters ";"
complete_words alpha alpine
set rl_completion_entry_function words
readline "> "
--- keys
x y;al\t<dump>\r

=== basic-quote-characters-default-and-effect
tags: rl_basic_quote_characters rl_completer_quote_characters
--- script
get rl_basic_quote_characters
file_write "my file.txt" "x"
set rl_completer_quote_characters "'\""
readline "> "
--- keys
cat 'my f\t<dump>\r

=== basic-quote-characters-replaced
tags: rl_basic_quote_characters
--- script
set rl_basic_quote_characters "|"
file_write "my file.txt" "x"
set rl_completer_quote_characters "|"
readline "> "
--- keys
cat |my f\t<dump>\r

=== basic-quote-characters-empty
tags: rl_basic_quote_characters
--- script
set rl_basic_quote_characters ""
set rl_completer_quote_characters NULL
readline "> "
--- keys
cat al\t<dump>\r

=== completion-invoking-key-tab
tags: rl_completion_invoking_key
--- script
def show
get rl_completion_invoking_key
get rl_completion_type
return NULL
end
set rl_attempted_completion_function script:show
readline "> "
--- keys
x\t\M-?\M-*\r

=== completion-invoking-key-custom-binding
tags: rl_completion_invoking_key
--- inputrc
"\C-o": complete
"\C-xm": menu-complete
--- script
def show
get rl_completion_invoking_key
return NULL
end
set rl_attempted_completion_function script:show
readline "> "
--- keys
x\C-o\C-xm\r

=== completion-invoking-key-vi
tags: rl_completion_invoking_key vi
--- inputrc
set editing-mode vi
set keyseq-timeout 50
--- script
def show
get rl_completion_invoking_key
return NULL
end
set rl_attempted_completion_function script:show
readline "> "
--- keys
x\t\e<pause>=*\r

=== completion-suppress-quote-on
tags: rl_completion_suppress_quote
--- script
file_write "my file.txt" "x"
set rl_completer_quote_characters "'\""
def q
set rl_completion_suppress_quote 1
return filename
end
set rl_attempted_completion_function script:q
readline "> "
--- keys
cat "my\t<dump>\r

=== completion-suppress-quote-off
tags: rl_completion_suppress_quote
--- script
file_write "my file.txt" "x"
set rl_completer_quote_characters "'\""
def q
get rl_completion_suppress_quote
return filename
end
set rl_attempted_completion_function script:q
readline "> "
--- keys
cat "my\t<dump>\r

