=== completion-word-break-hook-returns-empty
--- script
def brk
return ""
end
def show
args
return NULL
end
set rl_completion_word_break_hook script:brk
set rl_attempted_completion_function script:show
readline "> "
--- keys
a b c\t\r

=== completion-in-vi-command-mode
--- inputrc
set editing-mode vi
set keyseq-timeout 50
--- script
complete_words apple apricot
set rl_attempted_completion_function words
readline "> "
--- keys
x apr\e<pause>\\<dump>\r

=== vi-complete-star-and-equals
--- inputrc
set editing-mode vi
set keyseq-timeout 50
--- script
complete_words apple apricot
set rl_attempted_completion_function words
readline "> "
--- keys
x ap\e<pause>=<snap>*<dump>\r
