--- keys
x "with sp\t<dump>\r

=== dequoting-backslash
--- script
file_write "with space.txt" ""
set rl_completer_quote_characters "\""
set rl_filename_dequoting_function log
set rl_char_is_quoted_p backslash
readline "> "
--- keys
x with\\ sp\t<dump>\r

=== char-is-quoted-hook
--- script
file_write "with space.txt" ""
set rl_completer_quote_characters "\""
set rl_char_is_quoted_p log
readline "> "
--- keys
x a\\ b\t<dump>\r

=== filename-rewrite-hook
# every directory entry is passed through the hook before matching
--- script
def ren
return "renamed"
end
mkdir "one"
file_write "one/only" ""
set rl_filename_rewrite_hook script:ren
gen filename "one/ren"
gen filename "one/o"
gen filename "one/"

=== completion-rewrite-hook-log
--- script
set rl_completion_rewrite_hook log
gen filename "bet"
gen filename "" sort

=== completion-rewrite-hook-changes-text
--- script
def up
args
return "alpha"
end
set rl_completion_rewrite_hook script:up
gen filename "zz" sort

=== directory-completion-hook
--- script
set rl_directory_completion_hook log
readline "> "
--- keys
x subdir/in\t<dump>\r

=== directory-completion-hook-replaces
--- script
def redirect
args
replace_arg "subdir/"
return 1
end
set rl_directory_completion_hook script:redirect
readline "> "
--- keys
x elsewhere/in\t<dump>\r

=== directory-rewrite-hook
--- script
def redirect
args
replace_arg "subdir/"
return 1
end
set rl_directory_rewrite_hook script:redirect
readline "> "
--- keys
x elsewhere/in\t<dump>\r

=== filename-stat-hook
--- script
set rl_filename_stat_hook log
readline "> "
--- keys
x subd\t<dump>\r

=== filename-stat-hook-listing
--- inputrc
set visible-stats on
--- script
set rl_filename_stat_hook log
readline "> "
--- keys
x subdir/\t\t<snap>\r

=== generator-sequence
--- script
gen filename "alp" sort
gen filename "subdir/" sort
gen filename "subdir/i"
gen filename "./b"
gen filename "zz"

=== generator-state-restart
# calling with state 0 again restarts the scan
--- script
gen filename "alpha."
gen filename "alpha."

=== generator-tilde
--- script
gen filename "~/bet"
gen filename "~/subdir/" sort
set rl_completion_entry_function filename

=== generator-tilde-expand-tilde
--- inputrc
set expand-tilde on
--- script
rl_initialize
gen filename "~/bet"

=== generator-root-directory
--- script
gen filename "/dev/nul"

=== completion-matches-filename
--- script
rl_completion_matches "alp" filename sort
rl_completion_matches "subdir/" filename sort
rl_completion_matches "beta.c" filename
rl_completion_matches "nothing" filename

=== filename-completion-desired-set
--- script
def check
set rl_attempted_completion_over 0
return NULL
end
def after
get rl_filename_completion_desired
end
set rl_attempted_completion_function script:check
defun show-desired after "\C-t"
readline "> "
--- keys
x bet\t\C-t\r

=== long-listing-columns
--- script
def mk
file_append "longnames/file-with-a-rather-long-name-number" "x"
end
