# Completion behaviour driven by readline variables and the match display:
# show-all-if-ambiguous, show-all-if-unmodified, completion-query-items,
# page-completions, print-completions-horizontally,
# completion-display-width, completion-prefix-display-length,
# skip-completed-text, disable-completion, possible-/insert-completions.
# Matches come from a word list (rl_attempted_completion_function words).
tags: complete display
--- script
complete_words apple apricot avocado banana blueberry cherry
set rl_attempted_completion_function words
readline "> "

=== tab-unique
--- keys
ban\t<dump>\r

=== tab-common-prefix-rings
--- keys
ap\t<dump>\r

=== tab-twice-lists
--- keys
a\t\t<snap>\r

=== tab-three-times-lists-again
--- keys
a\t\t\t<snap>\r

=== tab-after-prefix-change-lists
--- keys
ap\t\t<snap>\r

=== tab-no-match
--- keys
zz\t\t<dump><snap>\r

=== tab-empty-word-lists-all
--- keys
\t\t<snap>\r

=== possible-completions-key
--- keys
b\M-?<snap>\r

=== possible-completions-single
--- keys
ch\M-?<snap><dump>\r

=== possible-completions-after-failed
# a failed completion followed by possible-completions with one match
# inserts it
--- keys
chx\t\C-?\M-?<dump>\r

=== possible-completions-no-match
--- keys
zz\M-?<snap>\r

=== possible-completions-bindable-equals
--- inputrc
"\C-x=": possible-completions
--- keys
a\C-x=<snap>\r

=== insert-completions
--- keys
a\M-*<dump>\r

=== insert-completions-single
--- keys
ch\M-*<dump>\r

=== insert-completions-undo
--- keys
a\M-*\C-_<dump>\r

=== insert-completions-no-match
--- keys
zz\M-*<dump>\r

=== show-all-if-ambiguous
--- inputrc
set show-all-if-ambiguous on
--- keys
a\t<snap><dump>\r

=== show-all-if-ambiguous-partial
# the common prefix is inserted and the list shown at once
--- inputrc
set show-all-if-ambiguous on
--- keys
ap\t<snap><dump>\r

=== show-all-if-ambiguous-unique
--- inputrc
set show-all-if-ambiguous on
--- keys
ban\t<snap><dump>\r

=== show-all-if-unmodified-no-prefix
--- inputrc
set show-all-if-unmodified on
--- keys
a\t<snap><dump>\r

=== show-all-if-unmodified-with-prefix
--- inputrc
set show-all-if-unmodified on
--- keys
ap\t<snap><dump>\t<snap>\r

=== query-items-yes
--- inputrc
set completion-query-items 3
--- keys
a\t\t<snap>y<snap>\r

=== query-items-space-is-yes
--- inputrc
set completion-query-items 3
--- keys
a\t\t \r

=== query-items-no
--- inputrc
set completion-query-items 3
--- keys
a\t\tn<snap>\r

=== query-items-rubout-is-no
--- inputrc
set completion-query-items 3
--- keys
a\t\t\C-?<snap>\r

=== query-items-other-key-rings
--- inputrc
set completion-query-items 3
--- keys
a\t\tx<snap>Y<snap>\r

=== query-items-abort
--- inputrc
set completion-query-items 3
--- keys
a\t\t\C-g<dump><snap>\r

=== query-items-exact-threshold
# the question is asked when the count reaches the threshold
--- inputrc
set completion-query-items 4
--- keys
\t\t<snap>n\r

=== query-items-below-threshold
--- inputrc
set completion-query-items 4
--- keys
a\t\t<snap>\r

=== query-items-zero-never-asks
--- inputrc
set completion-query-items 0
--- keys
\t\t<snap>\r

=== query-items-application-variable
--- script
complete_words apple apricot avocado banana blueberry cherry
set rl_attempted_completion_function words
set rl_completion_query_items 2
readline "> "
--- keys
a\t\t<snap>n\r

=== print-horizontally
screen: 30x24
--- inputrc
set print-completions-horizontally on
--- script
complete_words one two three four five six seven eight nine ten eleven
set rl_attempted_completion_function words
readline "> "
--- keys
\t\t<snap>\r

=== print-vertically
screen: 30x24
--- script
complete_words one two three four five six seven eight nine ten eleven
set rl_attempted_completion_function words
readline "> "
--- keys
\t\t<snap>\r

=== print-horizontally-single-column
screen: 20x24
--- inputrc
set print-completions-horizontally on
--- script
complete_words a-very-long-word-one a-very-long-word-two
set rl_attempted_completion_function words
readline "> "
--- keys
a-very-long-word-\M-?<snap>\r

=== exact-fit-columns
# when the items exactly fill the screen width one column is dropped
screen: 24x24
--- script
complete_words aaaaaa bbbbbb cccccc dddddd eeeeee ffffff
set rl_attempted_completion_function words
readline "> "
--- keys
\t\t<snap>\r

=== items-wider-than-screen
screen: 20x24
--- script
complete_words abcdefghijklmnopqrstuvwxyz-one abcdefghijklmnopqrstuvwxyz-two
set rl_attempted_completion_function words
readline "> "
--- keys
abc\M-?<snap>\r

=== completion-display-width
--- inputrc
set completion-display-width 20
--- keys
\t\t<snap>\r

=== completion-display-width-zero
--- inputrc
set completion-display-width 0
--- keys
\t\t<snap>\r

=== completion-display-width-larger-than-screen
--- inputrc
set completion-display-width 500
--- keys
\t\t<snap>\r

=== columns-env-overwritten-by-readline
# readline exports its own COLUMNS (rl_change_environment), so the
# variable has no effect on the listing
env: COLUMNS=25
--- keys
\t\t<snap>\r

=== columns-env-limits-listing
env: COLUMNS=25
--- script
complete_words apple apricot avocado banana blueberry cherry
set rl_attempted_completion_function words
set rl_change_environment 0
readline "> "
--- keys
\t\t<snap>\r

=== prefix-display-length
--- inputrc
set completion-prefix-display-length 2
--- script
complete_words prefix-alpha prefix-beta prefix-gamma
set rl_attempted_completion_function words
readline "> "
--- keys
prefix\M-?<snap>\r

=== prefix-display-length-dot
# a match whose remainder starts with '.' uses underscores
--- inputrc
set completion-prefix-display-length 2
--- script
complete_words common.c common.h common
set rl_attempted_completion_function words
readline "> "
--- keys
common\M-?<snap>\r

=== prefix-display-length-short-prefix
--- inputrc
set completion-prefix-display-length 10
--- script
complete_words prefix-alpha prefix-beta prefix-gamma
set rl_attempted_completion_function words
readline "> "
--- keys
prefix\M-?<snap>\r

=== prefix-display-length-match-equals-prefix
--- inputrc
set completion-prefix-display-length 2
--- script
complete_words prefix prefix-beta prefix-gamma
set rl_attempted_completion_function words
readline "> "
--- keys
prefix\M-?<snap>\r

=== prefix-display-length-filenames
--- inputrc
set completion-prefix-display-length 3
--- file dir/longprefix-one
--- file dir/longprefix-two
--- script
readline "> "
--- keys
x dir/longprefix-\M-?<snap>\r

