=== skip-completed-text
--- inputrc
set skip-completed-text on
--- keys
bananarama\C-a\C-f\C-f\t<dump>\r

=== skip-completed-text-off
--- keys
bananarama\C-a\C-f\C-f\t<dump>\r

=== skip-completed-text-middle-of-word
--- inputrc
set skip-completed-text on
--- keys
cherry pie\C-a\C-f\C-f\C-f\t<dump>\r

=== disable-completion
--- inputrc
set disable-completion on
--- keys
ap\t<dump>\r

=== disable-completion-variable
--- script
complete_words apple
set rl_attempted_completion_function words
set rl_inhibit_completion 1
readline "> "
--- keys
ap\t<dump>\r

=== multiline-prompt-listing
--- keys
first line\C-q\C-jsecond a\t\t<snap>\r

=== long-line-listing
screen: 20x24
--- keys
xxxxxxxxxxxxxxxxxxxxxxxxx a\t\t<snap>\r

=== control-chars-in-matches
--- script
complete_words "a\x01b" "a\x7fc" "a\td"
set rl_attempted_completion_function words
readline "> "
--- keys
a\t\t<snap>\r

=== multibyte-matches
--- script
complete_words "über" "überall" "übel"
set rl_attempted_completion_function words
readline "> "
--- keys
ü\t<dump>\t\t<snap>\r

=== wide-char-matches
--- script
complete_words "日本語" "日本人" "日曜日"
set rl_attempted_completion_function words
readline "> "
--- keys
日\t<dump>\t\t<snap>\r

=== duplicates-removed
--- script
complete_words dup dup dup dupe
set rl_attempted_completion_function words
readline "> "
--- keys
dup\t\t<snap>\r

=== duplicates-kept
--- script
def keepdups
set rl_ignore_completion_duplicates 0
end
complete_words dup dup dupe
set rl_attempted_completion_function script:keepdups
readline "> "
--- keys
dup\t\t<snap>\r

=== unsorted-matches
--- script
def nosort
set rl_sort_completion_matches 0
end
complete_words zeta alpha mu
set rl_attempted_completion_function script:nosort
readline "> "
--- keys
\t\t<snap>\r

=== unsorted-with-duplicates-off
--- script
def nosort
set rl_sort_completion_matches 0
set rl_ignore_completion_duplicates 0
end
complete_words zeta alpha mu alpha
set rl_attempted_completion_function script:nosort
readline "> "
--- keys
\t\t<snap>\r

=== sorted-duplicates-off
--- script
def dups
set rl_ignore_completion_duplicates 0
end
complete_words zeta alpha mu alpha
set rl_attempted_completion_function script:dups
readline "> "
--- keys
\t\t<snap>\r

=== exact-match-and-longer
--- script
complete_words app apple
set rl_attempted_completion_function words
readline "> "
--- keys
ap\t<dump>\t\t<snap>\r

=== vi-mode-no-bell-and-listing
--- inputrc
set editing-mode vi
--- keys
a\t<dump>\t<snap>\r
