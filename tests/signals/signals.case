# Signal handling inside readline: rl_catch_signals, the application's
# handler (the driver records signals), cleanup and reset, SIGWINCH.
tags: signals
--- script
readline "> " 2

=== sigint-keeps-line
tags: SIGINT
description: the echoed ^C is only partially overwritten on screen, so the screen is not compared
ignore: screen cursor
keys: abc\C-c<dump>d\r\r

=== sigint-clears-numeric-arg
tags: SIGINT numarg
keys: \M-3\C-c<dumpfull>x\r\r

=== sigint-frees-undo-list
tags: SIGINT undo
keys: abc\C-c<dumpfull>\C-_<dump>\r\r


=== sigint-during-quoted-insert-is-literal
tags: SIGINT quoted-insert
signals: off
--- script
readline "> "
--- keys
a\C-v<pause>\C-c<pause><dump>\r

=== sigint-during-vi-command
tags: SIGINT vi
--- inputrc
set editing-mode vi
set keyseq-timeout 50
--- script
readline "> "
--- keys
abc\e<pause>d\C-c<dumpfull>x\r

=== sigint-during-kbd-macro-definition
tags: SIGINT macro
--- script
readline "> "
--- keys
\C-x(ab\C-c<dumpfull>\C-x)\r

=== sigint-display
tags: SIGINT display
keys: abc\C-c<snap>def<snap>\r\r

=== sigint-catch-signals-off
tags: SIGINT rl_catch_signals
--- script
set rl_catch_signals 0
readline "> "
--- keys
abc\C-c<dumpfull><snap>d\r

=== sigint-default-disposition-kills
tags: SIGINT
--- script
signal INT default
readline "> "
echo not reached
--- keys
abc\C-c

=== sigint-ignored
tags: SIGINT
--- script
signal INT ignore
readline "> "
--- keys
abc\C-c<dump>d\r

=== sigquit
tags: SIGQUIT
--- script
readline "> "
--- keys
abc\C-\\<dump><snap>\r

=== sigtstp
tags: SIGTSTP
--- script
readline "> "
--- keys
abc\C-z<dump><snap>\r

=== sigtstp-catch-signals-off
tags: SIGTSTP rl_catch_signals
--- script
set rl_catch_signals 0
readline "> "
--- keys
abc\C-z<dump>\r

=== raise-sigterm-in-command
tags: SIGTERM
--- script
signal TERM record
def r
raise TERM
dumpfull
end
defun do-raise r
rl_bind_keyseq "\C-xr" do-raise
readline "> "
--- keys
abc\C-xr<dump>\r

=== raise-sighup-in-command
tags: SIGHUP
--- script
signal HUP record
def r
raise HUP
end
defun do-raise r
rl_bind_keyseq "\C-xr" do-raise
readline "> "
--- keys
abc\C-xr<dump>\r

