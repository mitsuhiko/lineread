# Input layer: rl_set_timeout / rl_timeout_remaining / rl_timeout_event_hook,
# rl_set_keyboard_input_timeout, rl_event_hook, and the library's own
# rl_getc blocking in select (driver `option libgetc`).
#
# libgetc cases that send signal keys only compare results: the runner
# learns about the signal from the driver's handler, i.e. while readline
# is still restoring the terminal.
#
# Timing: cases with <sleep:MS> rely on the runner being faster than the
# readline timeout (>= 1.5 s margin, also under ASan and load); expirations are always far shorter
# than the sleeps.
tags: input

=== timeout-expired-before-first-key
tags: rl_set_timeout rl_timeout_event_hook
--- script
set rl_timeout_event_hook log
rl_set_timeout 0 1
readline "> "
dumpfull
--- keys
abc\r

=== timeout-without-hook
tags: rl_set_timeout
--- script
rl_set_timeout 0 1
readline "> "
get rl_readline_state
rl_set_timeout 0 0
readline "> "
--- keys
abc\r

=== timeout-applies-to-each-readline
tags: rl_set_timeout
--- script
set rl_timeout_event_hook log
rl_set_timeout 0 1
readline "> "
readline "> "
--- keys
abc\r

=== timeout-cleared-with-zero
tags: rl_set_timeout rl_timeout_remaining
--- script
rl_set_timeout 0 1
rl_set_timeout 0 0
readline "> "
rl_timeout_remaining
--- keys
ok\r

=== timeout-long-not-expired
tags: rl_set_timeout rl_timeout_remaining
--- script
def r
rl_timeout_remaining
end
defun rem r
rl_bind_keyseq "\C-xr" rem
rl_set_timeout 100 0
readline "> "
rl_timeout_remaining
--- keys
ab\C-xrc\r

=== timeout-usecs-overflow
tags: rl_set_timeout
--- script
set rl_timeout_event_hook log
rl_set_timeout 0 3000000000
rl_set_timeout 50 2500000
readline "> "
--- keys
fine\r

=== timeout-hook-script
tags: rl_timeout_event_hook
--- script
def h
echo timed-out
dumpfull
end
set rl_timeout_event_hook script:h
rl_set_timeout 0 1
readline "> "
--- keys
x\r

=== timeout-in-callback-mode
tags: rl_set_timeout callback rl_timeout_event_hook
--- script
set rl_timeout_event_hook log
rl_set_timeout 0 1
callback "> "
get rl_readline_state
--- keys
abc\r

=== timeout-expires-between-keys
tags: rl_set_timeout rl_timeout_event_hook
timeout: 20
--- script
set rl_timeout_event_hook log
rl_set_timeout 1 500000
readline "> "
dump
rl_set_timeout 0 0
readline "> "
--- keys
abc<sleep:4500>x\r

=== timeout-libgetc-blocking-select
tags: rl_set_timeout libgetc
timeout: 20
eof: off
--- script
option libgetc
set rl_timeout_event_hook log
rl_set_timeout 1 500000
readline "> "
dumpfull
rl_set_timeout 0 0
readline "> "
--- keys
ab<sleep:4500>z\r

=== timeout-libgetc-not-reached
tags: rl_set_timeout libgetc
eof: off
--- script
option libgetc
rl_set_timeout 30 0
readline "> "
--- keys
abc\r

=== libgetc-basic-readline
tags: libgetc rl_getc
eof: off
--- script
option libgetc
readline "> "
readline "> "
--- keys
first\rsec<pause>ond\r

=== libgetc-sigint-interrupts-read
description: the signal is reported while readline still restores the terminal, so keys typed right after it may be echoed by the tty; only results are compared
ignore: screen cursor snaps
tags: libgetc SIGINT
eof: off
--- script
option libgetc
readline "> "
--- keys
abc\C-cdef\r

=== libgetc-sigwinch
description: the signal is reported while readline still restores the terminal, so keys typed right after it may be echoed by the tty; only results are compared
ignore: screen cursor snaps
tags: libgetc SIGWINCH
eof: off
--- script
option libgetc
readline "> "
--- keys
abc<resize:40x10>d<snap>\r

