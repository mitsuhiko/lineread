=== libgetc-esc-prefix-waits
tags: libgetc keyseq-timeout
eof: off
--- inputrc
set keyseq-timeout 50
"\ez": "ZED"
--- script
option libgetc
readline "> "
--- keys
a\e<pause>b\ez\r

=== keyboard-input-timeout-returns-old
tags: rl_set_keyboard_input_timeout
--- script
rl_set_keyboard_input_timeout 250
rl_set_keyboard_input_timeout 0
rl_set_keyboard_input_timeout -7
rl_set_keyboard_input_timeout 100000

=== keyboard-input-timeout-esc-vi
tags: rl_set_keyboard_input_timeout vi
--- inputrc
set editing-mode vi
--- script
rl_set_keyboard_input_timeout 1000
readline "> "
--- keys
abc\e<pause>0x<dump>\r

=== keyboard-input-timeout-isearch-esc
tags: rl_set_keyboard_input_timeout isearch
--- script
add_history "hello"
rl_set_keyboard_input_timeout 1000
readline "> "
--- keys
\C-rhel\e<pause>X<dump>\r

=== event-hook-called-once-then-removed
tags: rl_event_hook
--- script
def h
echo event
set rl_event_hook NULL
end
set rl_event_hook script:h
readline "> "
--- keys
abc\r

=== event-hook-sets-done
tags: rl_event_hook rl_done
--- script
def h
echo event
set rl_done 1
set rl_event_hook NULL
end
set rl_event_hook script:h
readline "> "
dumpfull

=== event-hook-inserts-text
tags: rl_event_hook
--- script
def h
rl_insert_text "hooked "
set rl_event_hook NULL
end
set rl_event_hook script:h
readline "> "
--- keys
tail\r

=== event-hook-input-available
tags: rl_event_hook rl_input_available_hook
--- script
def h
echo event
set rl_event_hook NULL
end
def avail
return 1
end
set rl_input_available_hook script:avail
set rl_event_hook script:h
readline "> "
--- keys
q\r
