=== reset-screen-size-from-env
tags: rl_reset_screen_size rl_get_screen_size
screen: 50x10
--- script
rl_initialize
rl_set_screen_size 5 30
rl_get_screen_size
rl_reset_screen_size
rl_get_screen_size

=== reset-screen-size-prefer-env
tags: rl_reset_screen_size rl_prefer_env_winsize
screen: 50x10
env: COLUMNS=40
env: LINES=7
--- script
set rl_prefer_env_winsize 1
rl_initialize
rl_get_screen_size
rl_set_screen_size 3 20
rl_reset_screen_size
rl_get_screen_size

=== reset-screen-size-during-readline
tags: rl_reset_screen_size
screen: 30x8
--- script
def b
rl_set_screen_size 8 10
rl_reset_screen_size
rl_get_screen_size
rl_forced_update_display
end
defun t b
rl_bind_keyseq "\C-xt" t
readline "> "
--- keys
0123456789abcdefghijklmnopqrstuvwxyz\C-xt<snap>\r

=== reset-terminal-dumb-during-readline
tags: rl_reset_terminal
--- script
def b
rl_reset_terminal "dumb"
get rl_terminal_name
rl_forced_update_display
end
defun t b
rl_bind_keyseq "\C-xt" t
readline "> "
--- keys
abc\C-xtd\C-b\C-b<snap>\r

=== reset-terminal-unknown
tags: rl_reset_terminal
--- script
rl_initialize
rl_reset_terminal "no-such-terminal-xyz"
get rl_terminal_name
rl_get_termcap "cl"
readline "> "
--- keys
ab\C-bX\r

=== reparse-colors-after-env-change
tags: rl_reparse_colors colored-stats
--- inputrc
set colored-stats on
--- file plain.txt
x
--- dir subdir
--- script
setenv LS_COLORS "di=01;34:fi=0"
rl_initialize
set rl_filename_completion_desired 1
capture display_match_list "" plain.txt subdir/
setenv LS_COLORS "di=01;32:fi=01;31"
rl_reparse_colors
capture display_match_list "" plain.txt subdir/

=== reparse-colors-extension
tags: rl_reparse_colors colored-stats
--- inputrc
set colored-stats on
--- dir d
--- file a.txt
x
--- script
setenv LS_COLORS "di=01;35"
rl_initialize
set rl_filename_completion_desired 1
capture display_match_list "" d/
setenv LS_COLORS "di=00;36:*.txt=01;33"
rl_reparse_colors
capture display_match_list "" d/ a.txt

=== reparse-colors-invalid
tags: rl_reparse_colors colored-stats
screen: 160x24
--- inputrc
set colored-stats on
--- dir d
--- script
rl_initialize
setenv LS_COLORS "di=01;3x:zz"
rl_reparse_colors
set rl_filename_completion_desired 1
capture display_match_list "" d/

