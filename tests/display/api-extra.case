# Redisplay and terminal API functions with few cases elsewhere, called
# from bound functions so the effect on the screen can be observed.
tags: display api

=== expand-prompt-during-readline
tags: rl_expand_prompt
--- script
def b
rl_expand_prompt "\001\e[7m\002new\001\e[0m\002$ "
rl_forced_update_display
end
defun t b
rl_bind_keyseq "\C-xt" t
readline "> "
--- keys
abc\C-xt<snap>d<snap>\r

=== expand-prompt-multiline-and-width
tags: rl_expand_prompt
--- script
rl_initialize
rl_expand_prompt "line1\nline2 \001\e[1m\002x\001\e[0m\002> "
rl_expand_prompt "\001\002"
rl_expand_prompt "tab\there> "
rl_expand_prompt "üñí> "

=== expand-prompt-unterminated-ignore
tags: rl_expand_prompt
--- script
rl_initialize
rl_expand_prompt "\001\e[1mrest> "
rl_expand_prompt "a\002b> "

=== on-new-line-with-prompt-after-output
tags: rl_on_new_line_with_prompt
--- script
def b
rl_crlf
capture echo nothing
rl_on_new_line_with_prompt
rl_redisplay
end
defun t b
rl_bind_keyseq "\C-xt" t
readline "$ "
--- keys
xyz\C-xtw<snap>\r

=== on-new-line-with-prompt-multiline-prompt
tags: rl_on_new_line_with_prompt
--- script
def b
rl_crlf
rl_on_new_line_with_prompt
rl_redisplay
end
defun t b
rl_bind_keyseq "\C-xt" t
readline "top\nbottom> "
--- keys
ab\C-xtc<snap>\r

