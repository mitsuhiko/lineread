getenv LINES

=== redisplay-function-hook
tags: rl_redisplay_function
--- script
set rl_redisplay_function log
readline "> "
--- keys
ab\r

=== redisplay-function-custom
tags: rl_redisplay_function
--- script
def rd
echo redisplay
end
set rl_redisplay_function script:rd
readline "> "
--- keys
a\r

