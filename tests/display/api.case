# Display-related API functions called from bound commands and hooks.
tags: display api
--- script
readline "> "

=== rl-message-and-clear
tags: rl_message rl_clear_message
--- script
def m
rl_message "hello message"
snap
rl_clear_message
snap
end
defun msg m
rl_bind_keyseq "\C-xm" msg
readline "> "
--- keys
abc\C-xm<snap>\r

=== rl-message-persists-until-clear
tags: rl_message
--- script
def m
rl_message "status"
end
def c
rl_clear_message
end
defun msg m
defun clr c
rl_bind_keyseq "\C-xm" msg
rl_bind_keyseq "\C-xc" clr
readline "> "
--- keys
abc\C-xm<snap>d<snap>\C-xc<snap>\r

=== rl-message-with-save-restore-prompt
tags: rl_message rl_save_prompt rl_restore_prompt
--- script
def m
rl_save_prompt
rl_message "searching: "
dumpfull
rl_restore_prompt
rl_clear_message
dumpfull
end
defun msg m
rl_bind_keyseq "\C-xm" msg
readline "pr> "
--- keys
abc\C-xm<snap>\r

=== rl-message-long-wraps
tags: rl_message
screen: 20x6
--- script
def m
rl_message "this is a very long status message"
snap
rl_clear_message
end
defun msg m
rl_bind_keyseq "\C-xm" msg
readline "> "
--- keys
abc\C-xm<snap>\r

=== rl-message-multiline-prompt
tags: rl_message
--- script
def m
rl_save_prompt
rl_message "msg> "
snap
rl_restore_prompt
rl_clear_message
end
defun msg m
rl_bind_keyseq "\C-xm" msg
readline "top\nbottom> "
--- keys
abc\C-xm<snap>\r

=== rl-message-outside-readline
tags: rl_message
--- script
rl_message "outside"
get rl_display_prompt
rl_clear_message

=== rl-save-restore-prompt-state
tags: rl_save_prompt rl_restore_prompt
--- script
def s
rl_save_prompt
get rl_prompt
get rl_display_prompt
rl_restore_prompt
get rl_prompt
end
defun sv s
rl_bind_keyseq "\C-xs" sv
readline "pp> "
--- keys
\C-xs\r

=== rl-on-new-line
tags: rl_on_new_line
--- script
def n
rl_crlf
echo "output"
rl_on_new_line
rl_redisplay
end
defun nl n
rl_bind_keyseq "\C-xn" nl
readline "> "
--- keys
abc\C-xn<snap>d<snap>\r

=== rl-on-new-line-after-printing
tags: rl_on_new_line rl_crlf
--- script
def n
rl_crlf
capture echo x
rl_on_new_line
rl_redisplay
end
defun nl n
rl_bind_keyseq "\C-xn" nl
readline "> " 
--- keys
abc\C-xn<snap>\r

=== rl-forced-update-display
tags: rl_forced_update_display
--- script
def f
rl_crlf
rl_forced_update_display
end
defun fud f
rl_bind_keyseq "\C-xf" fud
readline "> "
--- keys
abc\C-b\C-xf<snap>x<snap>\r

=== rl-redisplay-after-line-change
tags: rl_redisplay
--- script
def r
rl_replace_line "replaced text" 0
set rl_point 3
rl_redisplay
snap
end
defun rep r
rl_bind_keyseq "\C-xr" rep
readline "> "
--- keys
abc\C-xr<dump>\r

=== rl-crlf
tags: rl_crlf
--- script
def c
rl_crlf
end
defun crlf c
rl_bind_keyseq "\C-xc" crlf
readline "> "
--- keys
abc\C-xc<snap>d<snap>\r

=== rl-show-char
tags: rl_show_char visible
--- script
def s
rl_crlf
rl_show_char "a"
rl_show_char "\C-a"
rl_show_char 127
rl_show_char 233
rl_show_char 9
rl_crlf
rl_on_new_line
rl_redisplay
end
defun showc s
rl_bind_keyseq "\C-xs" showc
readline "> "
--- keys
\C-xs<snap>\r

=== rl-character-len
tags: rl_character_len
--- script
rl_initialize
rl_character_len "a" 0
rl_character_len "\C-a" 0
rl_character_len 127 0
rl_character_len 9 0
rl_character_len 9 3
rl_character_len 233 0
rl_character_len 128 0

=== rl-character-len-c-locale
tags: rl_character_len
env: LC_ALL=C
env: LC_CTYPE=C
--- script
rl_initialize
rl_character_len 233 0
rl_character_len 128 0

