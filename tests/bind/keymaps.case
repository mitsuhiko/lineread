env: LC_ALL=C
env: LC_CTYPE=C
--- script
rl_initialize
keymap_dump emacs

=== tty-special-chars-bound
# rl_initialize binds the tty's erase/kill/werase/lnext characters
--- script
rl_initialize
readline "> "
rl_function_of_keyseq "\x7f" emacs
rl_function_of_keyseq "\x15" emacs
rl_function_of_keyseq "\x17" emacs
rl_function_of_keyseq "\x16" emacs
rl_function_of_keyseq "\x7f" vi-insert
rl_function_of_keyseq "\x15" vi-insert
rl_function_of_keyseq "\x17" vi-insert
--- keys
x\r

=== tty-special-chars-not-bound
--- inputrc
set bind-tty-special-chars off
--- script
rl_bind_key "\C-w" kill-word
readline "> "
rl_function_of_keyseq "\x17" emacs
--- keys
x\r

=== tty-set-default-bindings
--- script
rl_initialize
keymap_new k bare
rl_tty_set_default_bindings k
keymap_dump k
rl_tty_unset_default_bindings k
keymap_dump k

=== keymap-variable-executing
tags: readline
--- script
def show
get rl_executing_keymap
get rl_executing_key
get rl_executing_keyseq
get rl_key_sequence_length
end
defun show-km show
rl_bind_keyseq '\C-xs' show-km
readline "> "
--- keys
\C-xs\r

=== tty-special-chars-not-bound-variable
--- script
rl_variable_bind "bind-tty-special-chars" "off"
rl_bind_key "\C-w" kill-word
readline "> "
rl_function_of_keyseq "\x17" emacs
--- keys
x\r

=== tty-unset-default-bindings-after-readline
--- script
readline "> "
keymap_new k bare
rl_tty_set_default_bindings k
keymap_dump k
rl_tty_unset_default_bindings k
keymap_dump k
rl_tty_unset_default_bindings emacs
rl_function_of_keyseq "\x17" emacs
rl_function_of_keyseq "\x15" emacs
--- keys
x\r
