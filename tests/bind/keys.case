--- script
rl_translate_keyseq '\x41'
rl_translate_keyseq '\x4'
rl_translate_keyseq '\x414'
rl_translate_keyseq '\xg'
rl_translate_keyseq '\xFF'
rl_translate_keyseq '\xfe'

=== translate-keyseq-other-escapes
--- script
rl_translate_keyseq "\\q\\w\\\"\'"
rl_translate_keyseq 'trailing\'
rl_translate_keyseq '\\\\'
rl_translate_keyseq ''

=== translate-keyseq-utf8
--- script
rl_translate_keyseq 'ä'
rl_translate_keyseq '\M-ä'

