# Key binding API in detail (bind.c): rl_bind_key*, rl_unbind_*,
# rl_bind_keyseq*, rl_set_key, rl_generic_bind, rl_macro_bind, shadowed
# keys (ANYOTHERKEY), function lookup and keyseq translation.
tags: bind api keys

=== bind-key-returns
--- script
rl_bind_key "a" forward-char
rl_bind_key 255 forward-char
rl_bind_key 256 forward-char
rl_bind_key -5 forward-char
rl_bind_key_in_map 1000 forward-char emacs

=== bind-key-overwrites-macro
--- script
rl_macro_bind "\C-t" "mac" emacs
rl_function_of_keyseq "\x14" emacs
rl_bind_key "\C-t" forward-word
rl_function_of_keyseq "\x14" emacs

=== bind-key-on-prefix-key
# binding a key that is a prefix keymap binds its default (ANYOTHERKEY)
--- script
rl_bind_key "\C-x" forward-word
rl_function_of_keyseq "\x18" emacs
rl_function_of_keyseq "\x18\x18" emacs
keymap_dump emacs-ctlx

=== bind-key-backslash-on-prefix
--- script
rl_bind_keyseq '\\a' kill-word
rl_bind_key "\\" forward-word
rl_function_of_keyseq "\\" emacs
rl_function_of_keyseq "\\a" emacs
keymap_dump emacs

=== bind-key-nul
--- script
rl_bind_key 0 forward-word
rl_function_of_keyseq_len "\x00" 1 emacs

=== bind-key-nul-on-prefix
--- script
rl_bind_keyseq '\C-@a' kill-word
rl_bind_key 0 forward-word
rl_function_of_keyseq_len "\x00" 1 emacs
rl_function_of_keyseq_len "\x00a" 2 emacs

=== bind-key-meta-char
--- script
rl_initialize
rl_bind_key "\M-q" kill-word
rl_function_of_keyseq "\xf1" emacs
rl_function_of_keyseq "\eq" emacs

=== bind-key-meta-force-prefix
--- script
rl_initialize
rl_variable_bind "force-meta-prefix" "on"
rl_bind_key "\M-q" kill-word
rl_function_of_keyseq "\eq" emacs
rl_function_of_keyseq "\xf1" emacs

=== bind-key-meta-force-prefix-no-esc-map
--- script
rl_initialize
rl_variable_bind "force-meta-prefix" "on"
keymap_new km bare
rl_bind_key_in_map "\M-q" kill-word km
keymap_dump km

=== bind-key-in-map-restores-current
--- script
rl_bind_key_in_map "z" kill-word vi-command
rl_get_keymap
rl_function_of_keyseq "z" vi-command
rl_function_of_keyseq "z" emacs

=== bind-key-uses-current-keymap
--- script
rl_set_keymap vi-insert
rl_bind_key "\C-t" kill-word
rl_function_of_keyseq "\x14" vi-insert
rl_function_of_keyseq "\x14" emacs

=== unbind-key
--- script
rl_unbind_key "\C-a"
rl_function_of_keyseq "\x01" emacs
rl_unbind_key_in_map "\C-e" emacs
rl_function_of_keyseq "\x05" emacs
rl_unbind_key 999

=== unbind-prefix-key
# unbinding a prefix key binds a do-nothing function as its default
--- script
rl_unbind_key "\C-x"
rl_function_of_keyseq "\x18" emacs
rl_function_of_keyseq "\x18\x18" emacs
keymap_dump emacs-ctlx

=== unbind-function-in-map
--- script
rl_unbind_function_in_map forward-char emacs
rl_function_of_keyseq "\x06" emacs
rl_function_of_keyseq "\e[C" emacs
rl_unbind_function_in_map forward-char emacs
rl_unbind_function_in_map vi-put emacs

=== unbind-function-in-submaps
--- script
rl_bind_keyseq '\C-xq' forward-word
rl_bind_keyseq '\eq' forward-word
rl_unbind_function_in_map forward-word emacs
rl_invoking_keyseqs forward-word

=== unbind-command-in-map
--- script
rl_unbind_command_in_map "backward-char" emacs
rl_invoking_keyseqs_in_map backward-char emacs
rl_unbind_command_in_map "no-such-command" emacs
rl_unbind_command_in_map "vi-put" emacs

=== bind-key-if-unbound-cases
--- script
rl_bind_key_if_unbound "\C-a" kill-word
rl_bind_key_if_unbound "\C-]" kill-word
rl_function_of_keyseq "\x1d" emacs
rl_bind_key_if_unbound "\C-\\" kill-word
rl_function_of_keyseq "\x1c" emacs
rl_bind_key_if_unbound_in_map "Z" kill-word vi-insert
rl_bind_key_if_unbound_in_map "Z" kill-word vi-command

=== bind-key-if-unbound-do-lowercase
# keys bound to do-lowercase-version count as unbound
--- script
rl_function_of_keyseq "\eX" emacs
rl_bind_keyseq_if_unbound "\eX" kill-word
rl_function_of_keyseq "\eX" emacs

=== bind-key-if-unbound-vi-movement-mode
# keys bound to vi-movement-mode count as unbound
--- script
rl_function_of_keyseq "\e" vi-insert
rl_bind_keyseq_if_unbound_in_map "\e" kill-word vi-insert
rl_function_of_keyseq "\e" vi-insert

=== bind-keyseq-if-unbound-sequences
--- script
rl_bind_keyseq_if_unbound '\C-x\C-z' kill-word
rl_function_of_keyseq "\x18\x1a" emacs
rl_bind_keyseq_if_unbound '\C-x\C-z' forward-word
rl_function_of_keyseq "\x18\x1a" emacs
rl_bind_keyseq_if_unbound NULL forward-word
rl_bind_keyseq_if_unbound '\C-x' forward-word

=== bind-keyseq-returns
--- script
rl_bind_keyseq "" forward-word
rl_bind_keyseq NULL forward-word
rl_bind_keyseq 'q' forward-word
rl_bind_keyseq_in_map '\C-q' forward-word vi-insert

=== bind-keyseq-creates-submaps
--- script
keymap_new top bare
rl_bind_keyseq_in_map 'abc' kill-word top
rl_bind_keyseq_in_map 'abd' upcase-word top
rl_bind_keyseq_in_map 'ax' downcase-word top
keymap_dump top

=== bind-keyseq-shadow-function
--- script
keymap_new top bare
rl_bind_keyseq_in_map 'a' kill-word top
rl_bind_keyseq_in_map 'ab' upcase-word top
keymap_dump top
rl_function_of_keyseq "a" top

=== bind-keyseq-shadow-macro
--- script
keymap_new top bare
rl_macro_bind 'a' 'text' top
rl_bind_keyseq_in_map 'ab' upcase-word top
keymap_dump top

=== bind-keyseq-shadow-do-lowercase-not-kept
--- script
rl_bind_keyseq '\eXy' kill-word
rl_function_of_keyseq "\eX" emacs
keymap_dump emacs-meta

=== bind-keyseq-overwrite-shadow
--- script
keymap_new top bare
rl_bind_keyseq_in_map 'a' kill-word top
rl_bind_keyseq_in_map 'ab' upcase-word top
rl_bind_keyseq_in_map 'a' forward-word top
keymap_dump top

=== unbind-restores-shadowed-function
# unbinding the only key of a shadowing submap restores the old function
--- script
keymap_new top bare
rl_bind_keyseq_in_map 'a' kill-word top
rl_bind_keyseq_in_map 'ab' upcase-word top
rl_bind_keyseq_in_map 'ab' NULL top
keymap_dump top

=== unbind-keeps-nonempty-submap
--- script
keymap_new top bare
rl_bind_keyseq_in_map 'a' kill-word top
rl_bind_keyseq_in_map 'ab' upcase-word top
rl_bind_keyseq_in_map 'ac' downcase-word top
rl_bind_keyseq_in_map 'ab' NULL top
keymap_dump top

=== set-key
--- script
rl_set_key '\C-xw' kill-word emacs
rl_function_of_keyseq "\x18w" emacs
rl_set_key '' kill-word emacs

=== generic-bind-types
--- script
keymap_new sub bare
rl_bind_key_in_map "x" kill-word sub
rl_generic_bind ISKMAP "\x18s" sub emacs
rl_generic_bind ISMACR "\x18m" "macro text" emacs
rl_generic_bind ISFUNC "\x18f" upcase-word emacs
rl_function_of_keyseq "\x18s" emacs
rl_function_of_keyseq "\x18sx" emacs
rl_function_of_keyseq "\x18m" emacs
rl_function_of_keyseq "\x18f" emacs

=== generic-bind-empty
--- script
rl_generic_bind ISFUNC "" kill-word emacs
rl_generic_bind ISMACR "" "x" emacs

=== generic-bind-macro-over-macro
--- script
rl_generic_bind ISMACR "\x18m" "one" emacs
rl_generic_bind ISMACR "\x18m" "two" emacs
rl_function_of_keyseq "\x18m" emacs

=== generic-bind-keymap-over-prefix
--- script
keymap_new sub bare
rl_bind_key_in_map "x" kill-word sub
rl_generic_bind ISKMAP "\x18" sub emacs
rl_function_of_keyseq "\x18x" emacs

=== macro-bind-translation
--- script
rl_macro_bind '\C-xa' '\C-a\ttab\\' emacs
rl_function_of_keyseq "\x18a" emacs
rl_macro_bind '\C-xb' '' emacs
rl_function_of_keyseq "\x18b" emacs

=== macro-bind-replaces-function
--- script
rl_macro_bind '\C-a' 'abc' emacs
rl_function_of_keyseq "\x01" emacs
rl_bind_keyseq '\C-a' kill-word
rl_function_of_keyseq "\x01" emacs

=== function-of-keyseq-default-map
--- script
rl_set_keymap vi-command
rl_function_of_keyseq "h" current
rl_set_keymap emacs
rl_function_of_keyseq "h" current

=== function-of-keyseq-prefix
--- script
rl_function_of_keyseq "\x18" emacs
rl_function_of_keyseq "\e" emacs
rl_function_of_keyseq "\e[" emacs
rl_function_of_keyseq "\e[A" emacs
rl_function_of_keyseq "\e[Z" emacs

=== function-of-keyseq-too-long
--- script
rl_function_of_keyseq "ab" emacs
rl_function_of_keyseq "\x01x" emacs

=== function-of-keyseq-empty
--- script
rl_function_of_keyseq "" emacs
rl_function_of_keyseq_len "" 0 emacs

=== function-of-keyseq-meta-force-prefix
--- script
rl_initialize
rl_variable_bind "force-meta-prefix" "on"
rl_function_of_keyseq "\xe6" emacs
rl_function_of_keyseq "\xe6" vi-insert
rl_function_of_keyseq "\xe6" vi-command

=== function-of-keyseq-len-embedded-nul
--- script
rl_bind_keyseq '\C-x\C-@a' kill-word
rl_function_of_keyseq_len "\x18\x00a" 3 emacs
rl_function_of_keyseq_len "\x18\x00" 2 emacs
rl_function_of_keyseq_len "\x18\x00a" 1 emacs

=== trim-arg-from-keyseq
--- script
rl_trim_arg_from_keyseq "\e1\x06" 3 emacs
rl_trim_arg_from_keyseq "\e1\e2\x06" 5 emacs
rl_trim_arg_from_keyseq "\x06" 1 emacs
rl_trim_arg_from_keyseq "\e1" 2 emacs
rl_trim_arg_from_keyseq "\e-\x06" 3 emacs
rl_trim_arg_from_keyseq "\x1512\x06" 4 emacs
rl_trim_arg_from_keyseq "\x15-\x06" 3 emacs
rl_trim_arg_from_keyseq "\x15--5\x06" 5 emacs
rl_trim_arg_from_keyseq "\x18\x06" 2 emacs
rl_trim_arg_from_keyseq "\x18" 1 emacs

=== trim-arg-from-keyseq-vi
--- script
rl_trim_arg_from_keyseq "3w" 2 vi-command
rl_trim_arg_from_keyseq "12w" 3 vi-command
rl_trim_arg_from_keyseq "w" 1 vi-command
rl_trim_arg_from_keyseq "3" 1 vi-command

=== translate-keyseq-control-variants
--- script
rl_translate_keyseq '\C-a\C-A\C-@\C-[\C-?\C-z'
rl_translate_keyseq '\C-\C-a'
rl_translate_keyseq '\C-1'

=== translate-keyseq-meta-variants
--- script
rl_translate_keyseq '\M-a\M-\C-b\C-\M-c\M-\M-d'
rl_translate_keyseq '\M-\e'

=== translate-keyseq-meta-force-prefix
--- script
rl_variable_bind "force-meta-prefix" "on"
rl_translate_keyseq '\M-a'
rl_translate_keyseq '\M-\C-@'
rl_translate_keyseq '\xe1'

=== translate-keyseq-incomplete-prefix
--- script
rl_translate_keyseq '\C-'
rl_translate_keyseq '\M-'
rl_translate_keyseq 'a\C-'
rl_translate_keyseq '\M-\C-'

