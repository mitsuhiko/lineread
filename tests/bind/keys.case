--- script
rl_translate_keyseq '\0'
rl_translate_keyseq '\1x'
rl_translate_keyseq '\12x'
rl_translate_keyseq '\123x'
rl_translate_keyseq '\1234'
rl_translate_keyseq '\8'
rl_translate_keyseq '\377'
rl_translate_keyseq '\777'

