=== named-function-lookup
--- script
rl_named_function "BEGINNING-OF-LINE"
rl_named_function "Beginning-Of-Line"
rl_named_function ""
rl_named_function "beginning-of-lin"
rl_named_function "self-insert"
rl_named_function "vi-movement-mode"
rl_named_function "driver-dump"

=== named-function-aliases
# some functions have several names
--- script
rl_named_function "backward-delete-char"
rl_named_function "backward-byte"
rl_named_function "kill-whole-line"
rl_named_function "vi-eof-maybe"
rl_named_function "complete"
rl_named_function "vi-complete"

=== add-defun-binds-key
--- script
def noop
echo called
end
defun my-cmd noop "\C-t"
rl_function_of_keyseq "\x14" emacs
defun my-other noop -1
rl_invoking_keyseqs my-other
rl_named_function "my-other"

=== add-defun-runs
tags: readline
--- script
def mine
echo mine-called
rl_insert_text "[x]"
end
defun my-cmd mine "\C-t"
readline "> "
--- keys
a\C-tb\r

=== binding-keymap-variable
--- script
rl_bind_keyseq '\C-xq' kill-word
get rl_binding_keymap
rl_bind_key "a" self-insert
get rl_binding_keymap
