#!/bin/sh
# lineread test runner: ./rlt --help (see docs/TESTING.md); ./rlt fuzz --help; ./rlt apps --help
HERE=$(cd "$(dirname "$0")" && pwd)
PLAT="$(uname -s | tr A-Z a-z)-$(uname -m)"
VENV="$HERE/runner/.venv-$PLAT"
if [ -x "$VENV/bin/python" ]; then
  PY="$VENV/bin/python"
elif python3 -c 'import pyte' 2>/dev/null; then
  PY=python3
else
  "$HERE/runner/setup.sh" >/dev/null || exit 1
  PY="$VENV/bin/python"
fi
MOD=lrt.cli
if [ "${1:-}" = fuzz ]; then MOD=lrt.fuzz; shift; fi
if [ "${1:-}" = apps ]; then shift; exec "$PY" "$HERE/tests/apps/run.py" "$@"; fi
PYTHONPATH="$HERE/runner${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m $MOD "$@"
